from openai import OpenAI
import os

client = OpenAI(
    
    base_url="https://hub.nhr.fau.de/api/llmgw/v1",
    api_key="API-KEY-FROM-PROF-EMAIL"
)

response = client.chat.completions.create(
    model="gpt-oss-120b",
